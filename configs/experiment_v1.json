{
  "protocol_version": "v1-pilot-draft",
  "formal_comparison_ready": false,
  "model": {
    "checkpoint": "Qwen/Qwen3.5-9B",
    "same_checkpoint_for_both_roles": true,
    "classification": {
      "decoding": "greedy",
      "temperature": 0.0,
      "top_p": 1.0,
      "top_k": -1,
      "max_tokens": 16,
      "seed": 0,
      "presence_penalty": 0.0,
      "frequency_penalty": 0.0,
      "repetition_penalty": 1.0,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "generation": {
      "decoding": "sampling",
      "temperature": 0.8,
      "top_p": 0.8,
      "top_k": 20,
      "max_tokens": 512,
      "seed_policy": "sha256_search_seed_condition_slot_attempt_operator",
      "presence_penalty": 0.0,
      "frequency_penalty": 0.0,
      "repetition_penalty": 1.0,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "critique": {
      "temperature": 0.3,
      "top_p": 0.8,
      "top_k": 20,
      "max_tokens": 768,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "joint_search": {
    "generations_after_initialization": 20,
    "prompts_file": "prompts/joint/humanPrompt.json",
    "generation_template_file": "prompts/joint/ga_crossover_mutation.txt",
    "operator_prompt_file": "prompts/joint/crossover_and_mutation_prompt.json",
    "operator_prompt_name": "baseline",
    "tasks": {
      "depsign": {
        "data_file": "data/processed/depsign/dev_100.tsv",
        "task_template_file": "prompts/depsign/depsign_task_Bi.txt"
      },
      "dreaddit": {
        "data_file": "data/processed/dreaddit/dre_dev_100.tsv",
        "task_template_file": "prompts/dreaddit/dreaddit_task_v1.txt"
      }
    }
  },
  "evaluation": {
    "fitness": "macro_f1"
  },
  "search": {
    "population_size": "from_prompt_file",
    "generations_after_initialization": 1,
    "early_stopping_patience": 5,
    "offspring_per_generation": "population_size",
    "parent_selection": "wheel",
    "zero_fitness_selection": "uniform",
    "crossover_probability": 0.2,
    "mutation_probability": 0.8,
    "operator_order": [
      "crossover",
      "mutation"
    ],
    "operator_requests_per_proposal": 1,
    "survivor_selection": "mu_plus_lambda_tournament",
    "tie_break": "first_drawn",
    "candidate_evaluation_budget": "(generations_after_initialization + 1) * population_size",
    "max_proposal_attempts_per_slot": 3,
    "max_transport_retries_per_request": 1,
    "exhausted_slot_action": "skip_invalid_child_and_continue",
    "deduplication": "exact_text",
    "reuse_evaluation_cache": false,
    "max_instruction_tokens": 256,
    "max_crossover_tokens": 256,
    "searchable_component": "instruction_block_only"
  },
  "component_search": {
    "generations_after_initialization": 20,
    "data_file": "data/processed/depsign/dev_100.tsv",
    "modes": {
      "binary": {
        "task_definition_file": "prompts/depsign/components/binary/task_definition.json",
        "label_definition_file": "prompts/depsign/components/binary/label_definition.json",
        "instruction_file": "prompts/depsign/components/binary/instruction.json"
      },
      "three_class": {
        "task_definition_file": "prompts/depsign/components/three_class/task_definition.json",
        "label_definition_file": "prompts/depsign/components/three_class/label_definition.json",
        "instruction_file": "prompts/depsign/components/three_class/instruction.json"
      }
    },
    "components": {
      "task_definition": {
        "operator_prompt_file": "prompts/depsign/components/operators/task_definition.json",
        "max_tokens": 256,
        "generation_max_tokens": 768
      },
      "label_definition": {
        "operator_prompt_file": "prompts/depsign/components/operators/label_definition_creative.json",
        "max_tokens": 512,
        "generation_max_tokens": 1536
      },
      "instruction": {
        "operator_prompt_file": "prompts/depsign/components/operators/instruction.json",
        "max_tokens": 256,
        "generation_max_tokens": 768
      }
    }
  }
}
